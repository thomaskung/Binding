{
  "projectId": "dc871eb6-6c3c-48a1-bcff-c841313b456e",
  "shape": "package",
  "pkg": "@binding/ui",
  "globalName": "BindingUI",
  "srcDir": "packages/ui/src",
  "tsconfig": "../../tsconfig.json",
  "cssEntry": ".ds-tailwind-cache.css",
  "buildCmd": "npx @tailwindcss/cli -i packages/ui/src/theme.css -o packages/ui/.ds-tailwind-cache.css",
  "componentSrcMap": {
    "CardAction": null, "CardContent": null, "CardDescription": null, "CardFooter": null, "CardHeader": null, "CardTitle": null,
    "DialogClose": null, "DialogContent": null, "DialogDescription": null, "DialogFooter": null, "DialogHeader": null, "DialogOverlay": null, "DialogPortal": null, "DialogTitle": null, "DialogTrigger": null,
    "SelectContent": null, "SelectGroup": null, "SelectItem": null, "SelectLabel": null, "SelectScrollDownButton": null, "SelectScrollUpButton": null, "SelectSeparator": null, "SelectTrigger": null, "SelectValue": null,
    "TabsContent": null, "TabsList": null, "TabsTrigger": null
  },
  "overrides": {
    "Card": { "cardMode": "column" },
    "Dialog": { "cardMode": "single", "primaryStory": "Open" },
    "Progress": { "cardMode": "single", "primaryStory": "Default" },
    "Select": { "cardMode": "single", "primaryStory": "Open" }
  }
}
