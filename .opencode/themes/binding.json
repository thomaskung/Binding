{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bgDark": "#1e2127",
    "bgPanelDark": "#272b33",
    "bgElementDark": "#2f343f",
    "bgLight": "#fafafa",
    "bgPanelLight": "#ffffff",
    "bgElementLight": "#f0f0f2",
    "txtDark": "#d7d8db",
    "txtMutedDark": "#8b8f96",
    "txtLight": "#1e2127",
    "txtMutedLight": "#6b6f76",
    "borderDark": "#3a3f4b",
    "red": "#e06c75",
    "redLight": "#d1383d",
    "amber": "#d19a66",
    "green": "#98c379",
    "teal": "#56b6c2",
    "blue": "#61afef",
    "purple": "#c678dd"
  },
  "theme": {
    "primary":            { "dark": "red",          "light": "redLight" },
    "secondary":          { "dark": "blue",         "light": "#3a7bd5" },
    "accent":             { "dark": "teal",         "light": "#2f9aa3" },
    "error":              { "dark": "#ff5370",      "light": "#c0392b" },
    "warning":            { "dark": "amber",        "light": "#b8863a" },
    "success":            { "dark": "green",        "light": "#5c8a3a" },
    "info":               { "dark": "blue",         "light": "blue" },
    "text":               { "dark": "txtDark",      "light": "txtLight" },
    "textMuted":          { "dark": "txtMutedDark", "light": "txtMutedLight" },
    "background":               { "dark": "bgDark",        "light": "bgLight" },
    "backgroundPanel":           { "dark": "bgPanelDark",   "light": "bgPanelLight" },
    "backgroundElement":         { "dark": "bgElementDark", "light": "bgElementLight" },
    "border":             { "dark": "borderDark",   "light": "#e0e0e2" },
    "borderActive":       { "dark": "red",          "light": "redLight" },
    "borderSubtle":       { "dark": "#2a2e38",      "light": "#ececef" },
    "diffAdded":               { "dark": "green",    "light": "green" },
    "diffRemoved":             { "dark": "red",      "light": "redLight" },
    "diffContext":             { "dark": "txtMutedDark", "light": "txtMutedLight" },
    "diffHunkHeader":          { "dark": "txtMutedDark", "light": "txtMutedLight" },
    "diffHighlightAdded":      { "dark": "green",    "light": "green" },
    "diffHighlightRemoved":    { "dark": "red",      "light": "redLight" },
    "diffAddedBg":             { "dark": "#213025", "light": "#e6f4e6" },
    "diffRemovedBg":           { "dark": "#2d1f22", "light": "#fde9e9" },
    "diffContextBg":           { "dark": "bgPanelDark", "light": "bgPanelLight" },
    "diffLineNumber":          { "dark": "txtMutedDark", "light": "txtMutedLight" },
    "diffAddedLineNumberBg":   { "dark": "#213025", "light": "#e6f4e6" },
    "diffRemovedLineNumberBg": { "dark": "#2d1f22", "light": "#fde9e9" },
    "markdownText":              { "dark": "txtDark",   "light": "txtLight" },
    "markdownHeading":           { "dark": "red",      "light": "redLight" },
    "markdownLink":              { "dark": "blue",     "light": "blue" },
    "markdownLinkText":          { "dark": "teal",     "light": "teal" },
    "markdownCode":              { "dark": "green",    "light": "green" },
    "markdownBlockQuote":        { "dark": "txtMutedDark", "light": "txtMutedLight" },
    "markdownEmph":              { "dark": "amber",    "light": "amber" },
    "markdownStrong":            { "dark": "red",      "light": "redLight" },
    "markdownHorizontalRule":    { "dark": "borderDark", "light": "#e0e0e2" },
    "markdownListItem":          { "dark": "red",      "light": "redLight" },
    "markdownListEnumeration":   { "dark": "teal",     "light": "teal" },
    "markdownImage":             { "dark": "blue",     "light": "blue" },
    "markdownImageText":         { "dark": "teal",     "light": "teal" },
    "markdownCodeBlock":         { "dark": "txtDark",  "light": "txtLight" },
    "syntaxComment":             { "dark": "txtMutedDark", "light": "txtMutedLight" },
    "syntaxKeyword":             { "dark": "purple",   "light": "#8e44ad" },
    "syntaxFunction":            { "dark": "blue",     "light": "blue" },
    "syntaxVariable":            { "dark": "red",      "light": "redLight" },
    "syntaxString":              { "dark": "green",    "light": "green" },
    "syntaxNumber":              { "dark": "amber",    "light": "amber" },
    "syntaxType":                { "dark": "teal",     "light": "teal" },
    "syntaxOperator":            { "dark": "txtDark",  "light": "txtLight" },
    "syntaxPunctuation":         { "dark": "txtMutedDark", "light": "txtMutedLight" }
  }
}