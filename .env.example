# --- Supabase (local dev values come from `pnpm db:start` output) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start>
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase start>

# --- AI provider selection ---
# stub  = deterministic local implementation, zero network calls (default for dev/CI)
# modal = self-hosted Qwen3 8B + Qwen3-Embedding-0.6B on Modal (see modal_app/README.md)
AI_PROVIDER=stub

# Required only when AI_PROVIDER=modal
MODAL_REDACT_URL=
MODAL_SUMMARY_URL=
MODAL_REFINE_URL=
MODAL_EMBED_URL=
MODAL_API_TOKEN=

# --- Matching parameters (placeholder economics — recalibrate with beta data) ---
MATCH_TOP_N=20
MATCH_COSINE_THRESHOLD=0.55

# --- Production email note ---
# Supabase free tier's built-in sender is rate-limited (~4 emails/hour) — fine
# for local dev (Inbucket at http://127.0.0.1:54324) but NOT for real beta
# invites. Before inviting real users, configure custom SMTP in the Supabase
# dashboard (Resend free tier: 100 emails/day) — no code change needed.
