# --- Supabase (HOSTED — local Supabase/Docker was retired 2026-08-06) ---
# Take these from the Supabase dashboard: Project Settings -> API.
# `pnpm dev` talks to the hosted staging project; there is no local stack.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- Migrations (applied to hosted Supabase) ---
# CI runs this automatically on merge (.github/workflows/deploy-staging.yml).
# Run `pnpm db:push` by hand only when you need a migration on staging ahead of a merge.
# Session-pooler URL: postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_DB_URL=

# --- Playwright e2e (runs against deployed staging; no local mode) ---
# Same Supabase project as above; the service-role key lets specs create and
# clean up their own per-run test users.
E2E_SUPABASE_URL=https://<project-ref>.supabase.co
E2E_SERVICE_ROLE_KEY=<service_role key>
# Staging's defense-in-depth gate (basic auth + shared-secret header).
E2E_STAGING_BASIC_USER=staging
E2E_STAGING_BASIC_PW=<STAGING_BASIC_AUTH password>
E2E_STAGING_SECRET=<STAGING_SHARED_SECRET>
# Optional: retarget the suite (e.g. a Vercel preview URL).
# E2E_BASE_URL=https://binding-staging.vercel.app
# Optional: set to 1 to make Playwright's globalSetup warm the Modal endpoints
# before the suite runs (needs MODAL_API_TOKEN below, or set MODAL_API_TOKEN
# separately if AI_PROVIDER=stub locally). Leave unset for Modal-free runs —
# the PR gate in ci.yml never sets this since none of its specs touch Modal.
# E2E_WARM_MODAL=1
# Required only when E2E_BASE_URL points at a Vercel PREVIEW deployment.
# Previews sit behind Vercel SSO, which 302s every request to vercel.com/sso-api
# BEFORE Next.js middleware runs — so the basic-auth and x-staging-auth values
# above never get a chance to apply, and Playwright cannot complete the SSO
# flow. Generate the bypass in Vercel (Project Settings -> Deployment
# Protection -> Protection Bypass for Automation). Not needed for the
# production staging URL, which is not SSO-protected.
# E2E_VERCEL_BYPASS_SECRET=

# --- Auth ---
# Password login is a demo/e2e-only shortcut. Enable locally for dev + e2e;
# NEVER set in a real deploy (Vercel env pins it to "false").
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=true

# Google OAuth (DESIGN.md §13h). Documenting only, not required: the app's
# "Continue with Google" button checks GoTrue's public /auth/v1/settings at
# click time and shows a friendly message when Google isn't enabled, so
# nothing breaks if these are unset. Real activation is a founder Supabase
# dashboard step (Auth > Providers > Google) plus flipping
# supabase/config.toml's [auth.external.google].enabled — these two vars only
# matter if local Supabase auth config is ever restored.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=

# --- AI provider selection ---
# stub  = deterministic local implementation, zero network calls (default for dev/CI)
# modal = self-hosted Qwen3 small/medium + Qwen3-Embedding-0.6B on Modal (see modal_app/README.md)
AI_PROVIDER=stub

# Required only when AI_PROVIDER=modal. Three apps, one bearer token:
#   binding-llm            /redact                      -> MODAL_REDACT_URL
#   binding-llm-small      /refine (credentials only)   -> MODAL_CREDENTIALS_URL
#   binding-llm            /extract                     -> MODAL_EXTRACT_URL
#   binding-llm            /fit-summary                 -> MODAL_SUMMARY_URL
#   binding-llm            /refine (profile/jd/career)  -> MODAL_REFINE_URL
#   binding-embeddings     /embed                       -> MODAL_EMBED_URL
MODAL_REDACT_URL=
MODAL_CREDENTIALS_URL=
MODAL_SUMMARY_URL=
MODAL_REFINE_URL=
MODAL_EMBED_URL=
MODAL_EXTRACT_URL=
MODAL_API_TOKEN=

# --- Matching parameters (placeholder economics — recalibrate with beta data) ---
MATCH_TOP_N=20
MATCH_COSINE_THRESHOLD=0.55

# --- Production email note ---
# Supabase free tier's built-in sender is rate-limited (~4 emails/hour) — fine
# for local dev (Inbucket at http://127.0.0.1:54324) but NOT for real beta
# invites. Before inviting real users, configure custom SMTP in the Supabase
# dashboard (Resend free tier: 100 emails/day) — no code change needed.
